# TeDDie 백엔드 환경 변수 예시
# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워주세요
# cp .env.example .env

# Database
DB_URL=jdbc:postgresql://localhost:5432/teddie
DB_USERNAME=teddie
DB_PASSWORD=teddie

# JWT (256-bit 이상 랜덤 문자열로 교체 필요)
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-256-bits-long

# Claude API
CLAUDE_API_KEY=sk-ant-...

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
